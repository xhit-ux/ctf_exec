# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ctf_exec
DB_CHARSET=utf8mb4
DB_PARSE_TIME=True
DB_LOCAL=Local

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 日志配置
# LOG_ENABLED 开启后，结构化日志同时输出到 console 和日志文件；
# 关闭时仅走 console（stderr），等价于传统的 log.Printf 行为。
LOG_ENABLED=false
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 日志文件格式：text | json（console 固定 text）
LOG_FORMAT=text
# 日志文件路径；为空则不写文件
LOG_FILE=
# 日志旋转：单文件最大 MB（默认 100）
LOG_MAX_SIZE=100
# 日志旋转：保留旧文件数量（默认 7）
LOG_MAX_BACKUPS=7
# 日志旋转：保留天数（默认 30）
LOG_MAX_AGE=30
# 日志旋转：旧文件是否 gzip 压缩（默认 true）
LOG_COMPRESS=true

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_LISTEN_HOST=
# 反向代理/网关地址（逗号分隔）。仅这些来源的 X-Forwarded-For / X-Real-IP 会被信任。
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
# 允许访问 API 的前端来源URL（逗号分隔）。生产环境请填写真实域名。
SERVER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
# Access Token 有效期（分钟），默认 15 分钟。
JWT_ACCESS_EXPIRATION_MINUTES=15
# Refresh Token 有效期（小时），默认 168 小时（7 天）；
# 当配置了 AUTH_NO_REMEMBER_ME_REFRESH_TTL_MINUTES 时本字段被覆盖。
JWT_REFRESH_EXPIRATION_HOURS=168

# ---------- 记住我 / 会话策略 ----------
# 未勾选记住我时 refresh token 的有效分钟数；为 0 表示沿用 JWT_REFRESH_EXPIRATION_HOURS。
AUTH_NO_REMEMBER_ME_REFRESH_TTL_MINUTES=120
# 勾选记住我时 refresh token 的有效天数（仅 user 角色生效，admin 始终走短 TTL）。
AUTH_REMEMBER_ME_REFRESH_TTL_DAYS=30
# 普通用户角色的会话模式：multi_session（默认）/ single_session。
AUTH_USER_SESSION_MODE=multi_session
# 普通用户最大并发活跃会话数；超出时驱逐最旧会话以放新会话进来。
AUTH_USER_MAX_ACTIVE_SESSIONS=5

# ---------- 登录暴力破解防护 ----------
# 账户级：窗口内累计失败次数（默认 10）达到即锁定（默认 15 分钟）。
LOGIN_FAIL_ACCOUNT_LIMIT=10
LOGIN_FAIL_ACCOUNT_WINDOW_MINUTES=15
LOGIN_FAIL_ACCOUNT_LOCK_MINUTES=15
# IP 级：窗口内累计失败次数（默认 60）达到即拒绝该 IP 登录请求（默认 30 分钟）。
LOGIN_FAIL_IP_LIMIT=60
LOGIN_FAIL_IP_WINDOW_MINUTES=60
LOGIN_FAIL_IP_LOCK_MINUTES=30

# HttpOnly 认证 Cookie 配置
AUTH_ACCESS_COOKIE_NAME=ctf_access_token
AUTH_REFRESH_COOKIE_NAME=ctf_refresh_token
# 跨子域共享时可设置为 .example.com，本地开发保持空字符串。
AUTH_COOKIE_DOMAIN=
# 生产环境 HTTPS 必须为 True。
AUTH_COOKIE_SECURE=False
# 可选: lax / strict / none。跨站前后端分离通常需 none + secure。
AUTH_COOKIE_SAMESITE=strict
# Flag 哈希使用 HMAC-SHA256 的服务端密钥；为空时回退使用 JWT_SECRET。
FLAG_HASH_SECRET=change-this-flag-secret-in-production

# ---------- WebSocket 心跳与在线状态 ----------
# 是否启用 WS 心跳上报。关闭后 /api/ws/connect 返回 403，profile 在线状态退化为「最近 15 分钟内活跃」启发。
WS_ENABLED=True
# 服务端发送 ping 的间隔（秒），客户端浏览器自动回复 pong。
WS_CLIENT_HEARTBEAT_INTERVAL_SEC=30
# 服务端判定离线的超时时间（秒），必须 ≥ 心跳间隔 × 2，过短会因抖动误判。
WS_PRESENCE_TIMEOUT_SEC=120
# 单用户最大并发 WS 连接数（多设备/多标签页）。
WS_MAX_CONNECTIONS_PER_USER=3
# WS 连接建立后周期性主动校验 access 会话有效性的间隔（秒）；0 表示关闭。
# 防御场景：用户被踢下线 / 单会话指针置换 / 撤销会话后能在最长此间隔内主动断开。
WS_SESSION_RECHECK_INTERVAL_SEC=60
# 是否启用 WS 调试日志（生产环境请关闭）。
VITE_WS_DEBUG=false

# 静态文件配置
STATIC_PATH=../static
MAX_UPLOAD_IMAGE_PACKAGE_SIZE=2147483648  # 2GB
MAX_UPLOAD_IMAGE_SIZE=10485760  # 10MB
MAX_UPLOAD_ATTACHMENT_SIZE=209715200  # 200MB

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_HOURS=1
DB_CONN_MAX_IDLE_TIME_MINUTES=10

# 提交限流配置
SUBMISSION_RATE_LIMIT=10  # 每分钟最大提交次数
SUBMISSION_RATE_WINDOW_SECONDS=60  # 时间窗口（秒）

# 排行榜配置
LEADERBOARD_CACHE_TTL_SECONDS=30  # 排行榜缓存时间（秒）
LEADERBOARD_REFRESH_TTL_MINUTES=10  # 排行榜刷新频率（分钟）

# 邮箱验证配置
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=test@yourdomain.com
EMAIL_VERIFY_CODE_TTL_SECONDS=300  # 验证码有效期（秒）
EMAIL_VERIFY_SEND_COOLDOWN_SECONDS=60  # 发送验证码的冷却时间（秒）
EMAIL_VERIFY_DAILY_LIMIT=5  # 每日发送验证码的最大次数
# 验证码（注册 / 密码重置）哈希使用 HMAC-SHA256，密钥独立于 JWT_SECRET；为空时回退到 JWT_SECRET。
EMAIL_CODE_HMAC_SECRET=change-this-email-code-secret-in-production
# 单个验证码生命周期内允许的最大核验失败次数；超过后立即作废验证码并要求重新申请。
EMAIL_VERIFY_FAIL_LIMIT=10

# Turnstile 人机验证配置
TURNSTILE_ENABLED=True # 是否启用 Turnstile 验证(前提是已经填写好 site key 和 secret key)
# 注意：若需在其他设备通过局域网 IP/域名访问注册页，请将该主机名加入 Turnstile 的 Hostname Allowlist。
VITE_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
# Secret/Site Key 首尾勿留空格或换行（.env 易被编辑器自动加换行导致校验失败）
# 服务端校验不向 Cloudflare 传 remoteip（避免 Vite 反代下 IP 与 Turnstile 签发 IP 不一致导致验证失败）

# ============================================================
# RabbitMQ — 容器实例创建任务队列
# ============================================================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# 队列名：容器实例创建任务
RABBITMQ_QUEUE_CHALLENGE=challenge_instance_create
# Worker 并发数（同时处理的任务数）
RABBITMQ_WORKER_CONCURRENCY=3
# Worker 单任务最大等待时间（秒），超时标记 timeout
RABBITMQ_TASK_TIMEOUT_SECONDS=120
# 连接断开后重连间隔（秒）
RABBITMQ_RECONNECT_DELAY=5

# ============================================================
# Container & k3s
# ============================================================

# k3s 集群连接
KUBECONFIG_PATH=/root/.kube/config

# 每用户最大并发容器数（不同题目数）
MAX_CONCURRENT_CONTAINERS=3

# 容器实例 TTL 全局唯一值（秒），不允许题目级覆盖
DEFAULT_CONTAINER_TTL=3600

# Namespace 前缀
NAMESPACE_PREFIX=ctf

# Registry 固定节点 hostname（空 = 自动选第一个节点）
INFRA_NODE_NAME=

# Kata Containers runtime class name（k3s 中配置）
KATA_RUNTIME_CLASS=kata

# ============================================================
# MinIO题目附件存储配置
# ============================================================

# 是否启用 MinIO 存储题目附件。如果启用，必须正确配置以下 MinIO 相关环境变量。
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000 # MinIO 服务地址，格式为 host:port
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=false

# 桶名前缀
MINIO_BUCKET_PREFIX=ctf

# 预签名 URL 有效期（秒）
MINIO_PRESIGN_EXPIRY=600

# ============================================================
# Flag（实例注入）
# ============================================================

# 动态 flag 生成模板
FLAG_TEMPLATE=flag{%s}
# 这一项你可以定义的是flag{}这六个字符，比如EXECTF{%s}
# 最终的 flag 会是 EXECTF{<uuid32>}，其中 %s 会被替换为 32 位 UUID（去掉连字符）。

# ============================================================
# Ingress（Web 题）
# ============================================================

# 泛域名模板，{id} 会被替换为实例 ID
INGRESS_DOMAIN_TEMPLATE={id}.chal.example.com
# chal.example.com 是你自己的域名，{id} 会被替换为每个用户的实例 ID 或题目 ID，这样每个用户访问题目的时候都会有一个独立的子域名。
# Web 题的泛域名模板。创建 Ingress 时把 {id} 替换为实例 ID 或题目 ID，每个用户拿到独立的子域名访问题目。
# 用户A启动Web题 → a1b2c3.chal.example.com
# 用户B启动同一题 → d4e5f6.chal.example.com
# 前提是你配了泛域名 DNS：*.chal.example.com → k3s 节点 IP，以及 Traefik Ingress 能匹配到。

# Traefik Ingress class
INGRESS_CLASS=traefik
# 告诉 k8s 这个 Ingress 资源由 Traefik 控制器处理。
# k3s 默认自带 Traefik，但如果你集群里有多个 Ingress 控制器（比如还装了 nginx-ingress），
# 就需要指定 ingressClassName 来区分。k3s 单控制器的话也可以不加，但写上更明确。

# TLS（可选，配合 cert-manager）
INGRESS_TLS_ENABLED=True
INGRESS_TLS_SECRET=wildcard-chal-tls
# 如果启用 TLS，k3s 里需要有个 Secret 存储证书，名字就是 INGRESS_TLS_SECRET 的值。
# 生产环境建议配合 cert-manager 自动申请 Let's Encrypt 证书，或者你也可以手动创建 Secret，放入自签证书（不推荐，浏览器会警告）。

# 仓库配置（用于存储容器题目镜像）
# 开启后使用指定的仓库地址。需要认证时同时填写用户名和密码。
REGISTRY_EXTERNAL=false
REGISTRY_HOST=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# TCP 题返回给用户的主机地址，留空时使用集群节点配置。
CHALLENGE_PUBLIC_HOST=
# 仓库 PVC 大小
REGISTRY_STORAGE_SIZE=30Gi

# 根用户默认密码
ROOT_DEFAULT_PASSWORD=