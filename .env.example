# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=111111
DB_NAME=ctf_exec
DB_CHARSET=utf8mb4
DB_PARSE_TIME=True
DB_LOCAL=Local

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# 反向代理/网关地址（逗号分隔）。仅这些来源的 X-Forwarded-For / X-Real-IP 会被信任。
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
# 允许访问 API 的前端来源URL（逗号分隔）。生产环境请填写真实域名。
SERVER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
# Access Token 有效期（分钟），默认 15 分钟。
JWT_ACCESS_EXPIRATION_MINUTES=15
# Refresh Token 有效期（小时），默认 168 小时（7 天）。
JWT_REFRESH_EXPIRATION_HOURS=168
# HttpOnly 认证 Cookie 配置
AUTH_ACCESS_COOKIE_NAME=ctf_access_token
AUTH_REFRESH_COOKIE_NAME=ctf_refresh_token
# 跨子域共享时可设置为 .example.com，本地开发保持空字符串。
AUTH_COOKIE_DOMAIN=
# 生产环境 HTTPS 必须为 True。
AUTH_COOKIE_SECURE=False
# 可选: lax / strict / none。跨站前后端分离通常需 none + secure。
AUTH_COOKIE_SAMESITE=lax
# Flag 哈希使用 HMAC-SHA256 的服务端密钥；为空时回退使用 JWT_SECRET。
FLAG_HASH_SECRET=change-this-flag-secret-in-production

# 静态文件配置
STATIC_PATH=../static
MAX_UPLOAD_IMAGE_PACKAGE_SIZE=2147483648  # 2GB
MAX_UPLOAD_IMAGE_SIZE=10485760  # 10MB
MAX_UPLOAD_ATTACHMENT_SIZE=209715200  # 200MB

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_HOURS=1
DB_CONN_MAX_IDLE_TIME_MINUTES=10

# 提交限流配置
SUBMISSION_RATE_LIMIT=10  # 每分钟最大提交次数
SUBMISSION_RATE_WINDOW_SECONDS=60  # 时间窗口（秒）

# 排行榜配置
LEADERBOARD_CACHE_TTL_SECONDS=30  # 排行榜缓存时间（秒）
LEADERBOARD_REFRESH_TTL_MINUTES=10  # 排行榜刷新频率（分钟）

# 邮箱验证配置
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=test@yourdomain.com
EMAIL_VERIFY_CODE_TTL_SECONDS=300  # 验证码有效期（秒）
EMAIL_VERIFY_SEND_COOLDOWN_SECONDS=60  # 发送验证码的冷却时间（秒）
EMAIL_VERIFY_DAILY_LIMIT=5  # 每日发送验证码的最大次数

# Turnstile 人机验证配置
TURNSTILE_ENABLED=True # 是否启用 Turnstile 验证(前提是已经填写好 site key 和 secret key)
# 注意：若需在其他设备通过局域网 IP/域名访问注册页，请将该主机名加入 Turnstile 的 Hostname Allowlist。
VITE_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key

# ============================================================
# Container & k3s
# ============================================================

# k3s 集群连接
KUBECONFIG_PATH=/root/.kube/config

# 每用户最大并发容器数（不同题目数）
MAX_CONCURRENT_CONTAINERS=3

# 全局默认 TTL（秒），可在题目级别覆盖
DEFAULT_CONTAINER_TTL=3600

# Namespace 前缀
NAMESPACE_PREFIX=ctf

# Kata Containers runtime class name（k3s 中配置）
KATA_RUNTIME_CLASS=kata

# ============================================================
# MinIO题目附件存储配置
# ============================================================

# 是否启用 MinIO 存储题目附件。如果启用，必须正确配置以下 MinIO 相关环境变量。
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000 # MinIO 服务地址，格式为 host:port
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=False

# 桶名前缀
MINIO_BUCKET_PREFIX=ctf

# 预签名 URL 有效期（秒）
MINIO_PRESIGN_EXPIRY=600

# ============================================================
# Flag（实例注入）
# ============================================================

# 动态 flag 生成模板
FLAG_TEMPLATE=flag{%s}
# 这一项你可以定义的是flag{}这六个字符，比如EXECTF{%s}
# 最终的flag会是EXECTF{随机字符串}，其中%s会被替换为随机字符串。

# ============================================================
# Ingress（Web 题）
# ============================================================

# 泛域名模板，{id} 会被替换为实例 ID
INGRESS_DOMAIN_TEMPLATE={id}.chal.example.com
# chal.example.com 是你自己的域名，{id} 会被替换为每个用户的实例 ID 或题目 ID，这样每个用户访问题目的时候都会有一个独立的子域名。
# Web 题的泛域名模板。创建 Ingress 时把 {id} 替换为实例 ID 或题目 ID，每个用户拿到独立的子域名访问题目。
# 用户A启动Web题 → a1b2c3.chal.example.com
# 用户B启动同一题 → d4e5f6.chal.example.com
# 前提是你配了泛域名 DNS：*.chal.example.com → k3s 节点 IP，以及 Traefik Ingress 能匹配到。

# Traefik Ingress class
INGRESS_CLASS=traefik
# 告诉 k8s 这个 Ingress 资源由 Traefik 控制器处理。
# k3s 默认自带 Traefik，但如果你集群里有多个 Ingress 控制器（比如还装了 nginx-ingress），
# 就需要指定 ingressClassName 来区分。k3s 单控制器的话也可以不加，但写上更明确。

# TLS（可选，配合 cert-manager）
INGRESS_TLS_ENABLED=True
INGRESS_TLS_SECRET=wildcard-chal-tls
# 如果启用 TLS，k3s 里需要有个 Secret 存储证书，名字就是 INGRESS_TLS_SECRET 的值。
# 生产环境建议配合 cert-manager 自动申请 Let's Encrypt 证书，或者你也可以手动创建 Secret，放入自签证书（不推荐，浏览器会警告）。

# 仓库配置（用于存储容器题目镜像）
REGISTRY_HOST=localhost:5000
# 仓库用户名和密码，如果你的私有仓库需要认证的话。没有认证可以留空。
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 根用户默认密码
ROOT_DEFAULT_PASSWORD=11111111