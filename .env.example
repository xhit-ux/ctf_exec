# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=111111
DB_NAME=ctf_exec
DB_CHARSET=utf8mb4
DB_PARSE_TIME=True
DB_LOCAL=Local

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# 反向代理/网关地址（逗号分隔）。仅这些来源的 X-Forwarded-For / X-Real-IP 会被信任。
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
# 允许访问 API 的前端来源（逗号分隔）。生产环境请填写真实域名。
SERVER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
# Access Token 有效期（分钟），默认 15 分钟。旧字段 JWT_EXPIRATION_HOURS 已弃用。
JWT_ACCESS_EXPIRATION_MINUTES=15
# Refresh Token 有效期（小时），默认 168 小时（7 天）。
JWT_REFRESH_EXPIRATION_HOURS=168
# HttpOnly 认证 Cookie 配置
AUTH_ACCESS_COOKIE_NAME=ctf_access_token
AUTH_REFRESH_COOKIE_NAME=ctf_refresh_token
# 跨子域共享时可设置为 .example.com，本地开发保持空字符串。
AUTH_COOKIE_DOMAIN=
# 生产环境 HTTPS 必须为 True。
AUTH_COOKIE_SECURE=False
# 可选: lax / strict / none。跨站前后端分离通常需 none + secure。
AUTH_COOKIE_SAMESITE=lax
# Flag 哈希使用 HMAC-SHA256 的服务端密钥；为空时回退使用 JWT_SECRET。
FLAG_HASH_SECRET=change-this-flag-secret-in-production

# 静态文件配置
STATIC_PATH=../static
MAX_UPLOAD_SIZE=10485760  # 10MB

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_HOURS=1
DB_CONN_MAX_IDLE_TIME_MINUTES=10

# 提交限流配置
SUBMISSION_RATE_LIMIT=10  # 每分钟最大提交次数
SUBMISSION_RATE_WINDOW_SECONDS=60  # 时间窗口（秒）

# 排行榜配置
LEADERBOARD_CACHE_TTL_SECONDS=30  # 排行榜缓存时间（秒）
LEADERBOARD_REFRESH_TTL_MINUTES=10  # 排行榜刷新频率（分钟）


# 邮箱验证配置
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=test@yourdomain.com
EMAIL_VERIFY_CODE_TTL_SECONDS=300  # 验证码有效期（秒）
EMAIL_VERIFY_SEND_COOLDOWN_SECONDS=60  # 发送验证码的冷却时间（秒）
EMAIL_VERIFY_DAILY_LIMIT=5  # 每日发送验证码的最大次数

# Turnstile 人机验证配置
TURNSTILE_ENABLED=True # 是否启用 Turnstile 验证(前提是已经填写好 site key 和 secret key)
# 注意：若需在其他设备通过局域网 IP/域名访问注册页，请将该主机名加入 Turnstile 的 Hostname Allowlist。
VITE_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key


# 根用户默认密码
ROOT_DEFAULT_PASSWORD=11111111